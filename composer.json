{
	"name": "xchert/file-reader",
	"description": "A memory-efficient PHP library for streaming and iterating files with built-in charset conversion",
	"type": "library",
	"keywords": [
		"csv",
		"file-reader",
		"file-iterator",
		"charset-conversion",
		"encoding"
	],
	"license": "MIT",
	"authors": [
		{
			"name": "Dustin Simon"
		}
	],
	"support": {
		"issues": "https://github.com/x-chert/file-reader/issues",
		"source": "https://github.com/x-chert/file-reader"
	},
	"autoload": {
		"psr-4": {
			"Xchert\\FileReader\\": "src/"
		},
		"files": [
			"src/Io/register_stream_filters.php"
		],
		"exclude-from-classmap": [
			"src/Test/"
		]
	},
	"require": {
		"php": "^8.4",
		"ext-iconv": "*",
		"ext-xmlreader": "*",
		"ext-simplexml": "*",
		"ext-mbstring": "*",
		"xchert/util": "~1.0",
		"symfony/serializer": "~7.0 || ~8.0"
	},
	"require-dev": {
		"phpunit/phpunit": "^13.3"
	},
	"archive": {
		"exclude": [
			"/.github"
		]
	}
}
